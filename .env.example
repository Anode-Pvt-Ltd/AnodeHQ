# =============================================================
# Anode — environment
# Copy to .env.local and fill in. Spec §18.3.
#
# The site RUNS WITHOUT any of these: with no Supabase project
# configured the content layer serves the typed seed dataset in
# src/content, so every public page renders and is navigable.
# Filling in the three NEXT_PUBLIC_SUPABASE_* / SERVICE_ROLE
# values switches the same query layer over to the database.
# =============================================================

# ---- Site ---------------------------------------------------
# Canonical URLs, OG tags, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase -----------------------------------------------
# public  — safe to ship; it grants exactly what the RLS policies allow
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server  — bypasses RLS. Imported in exactly one file
#           (src/lib/supabase/service.ts). Rotate every 90 days.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets ------------------------------------------------
# Shared with the database trigger that purges cache tags.
# Compared with timingSafeEqual, never ===.
REVALIDATE_SECRET=

# Entry token for Draft Mode preview.
PREVIEW_SECRET=

# Salts the IP hash used for rate limiting. NEVER rotate in place:
# doing so invalidates every live rate-limit window.
IP_HASH_PEPPER=change-me-to-a-long-random-string

# ---- Anti-abuse ---------------------------------------------
# Cloudflare Turnstile. When TURNSTILE_SECRET_KEY is empty the
# challenge is skipped rather than failing closed, so local
# development works; the rate limiter still applies.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Email --------------------------------------------------
# Resend. When empty, sends are logged to the console instead —
# the request still succeeds and the visitor still gets a reference.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anode <hello@anode.example>
SALES_EMAIL=quotes@anode.example

# ---- Optional -----------------------------------------------
CRON_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
